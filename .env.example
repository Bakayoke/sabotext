# Railway / server environment
PORT=3001
PUBLIC_APP_URL=https://sabotext.com
# Optional CORS (comma-separated). Default allows localhost + sabotext.com
# CORS_ORIGIN=https://sabotext.com,https://www.sabotext.com

# Stripe (sabotext)
# 1. Developers → API keys → Secret key (start with sk_test_…)
# 2. Optional: Developers → Webhooks → endpoint
#    URL: https://sabotext-production.up.railway.app/api/stripe/webhook
#    Event: checkout.session.completed
# 3. Paste webhook signing secret (whsec_…)
#
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: custom Price ID. If empty, Checkout uses inline amounts.
# STRIPE_PARTY_PRICE_ID=price_...
# STRIPE_PARTY_AMOUNT_ORE=3900
# STRIPE_PARTY_WEEK_AMOUNT_ORE=9900
# Optional dedicated Stripe Price IDs:
# STRIPE_PARTY_PRICE_ID=price_...
# STRIPE_PARTY_WEEK_PRICE_ID=price_...
# First-time −30% coupon id (auto-created if missing):
# STRIPE_FIRST_PARTY_COUPON=sabotext_first30
#
# Promo codes (comma-separated). Default free code is set in code;
# override here if needed. Leave unset to keep the built-in owner code.
# Example: PARTY_PASS_CODES=TESTKVALL,DEMO123
# Codes are matched case-insensitively. Redeploy after changing.
# PARTY_PASS_CODES=
# Optional HMAC secret for party tokens (defaults to PARTY_PASS_CODES):
# PARTY_TOKEN_SECRET=

# Persistence (Party passes + rooms across restarts / mid-match redeploys)
# Prefer Redis on Railway:
# 1. Add Redis plugin to the project
# 2. On the Sabotext API service → Variables → add reference:
#      REDIS_URL = ${{Redis.REDIS_URL}}
#    (name may be "Redis" or "redis" — pick the Redis service variable)
# Or paste the public/private URL manually.
# REDIS_URL=redis://default:…@….railway.internal:6379
# Also accepted: REDIS_PRIVATE_URL, REDIS_PUBLIC_URL, or REDISHOST+REDISPASSWORD
# Or mount a volume at /data (auto-detected) or set:
# SABOTEXT_DATA_DIR=/data
