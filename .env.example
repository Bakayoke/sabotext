# Railway / server environment
PORT=3001
PUBLIC_APP_URL=https://sabotext.com
# Optional CORS (comma-separated). Default allows localhost + sabotext.com
# CORS_ORIGIN=https://sabotext.com,https://www.sabotext.com

# Persistence (rooms across restarts / mid-match redeploys)
# Prefer Redis on Railway:
# 1. Add Redis plugin to the project
# 2. On the Sabotext API service → Variables → add reference:
#      REDIS_URL = ${{Redis.REDIS_URL}}
# Or paste the public/private URL manually.
# REDIS_URL=redis://default:…@….railway.internal:6379
# Also accepted: REDIS_PRIVATE_URL, REDIS_PUBLIC_URL, or REDISHOST+REDISPASSWORD
# Or mount a volume at /data (auto-detected) or set:
# SABOTEXT_DATA_DIR=/data

# Admin daily game-start stats (HTML/JSON)
# ADMIN_STATS_TOKEN=long-secret-shared-with-your-other-games
# Then open: https://YOUR-RAILWAY-URL/api/admin/stats?token=…&format=html
